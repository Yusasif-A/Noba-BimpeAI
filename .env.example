# Copy to .env and fill in. Never commit the real .env.

# --- LiveKit (Cloud only — WhatsApp calling does not work self-hosted) ---
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# --- WhatsApp Business (Meta Cloud API) ---
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_GRAPH_VERSION="v23.0"

# --- LLM ---
FINETUNED_BASE_URL=""
MODEL="google/gemma-4-E4B-it"
API_KEY=""

# --- English speech (Hausa/Igbo/Yoruba come later) ---
ENGLISH_STT_API_URL=""
ENGLISH_STT_MODEL="whisper-1"
ENGLISH_TTS_BASE_URL=""
ENGLISH_TTS_MODEL="nigerian-english-xtts"
ENGLISH_TTS_VOICE="female2"

# --- Twilio SIP trunk (real phone calls — the transport that works in Nigeria) ---
# From Twilio Console > Elastic SIP Trunking > Trunks > your trunk > Termination
TWILIO_TERMINATION_URI="your-trunk.pstn.twilio.com"
TWILIO_SIP_USERNAME=""
TWILIO_SIP_PASSWORD=""
TWILIO_PHONE_NUMBER="+234..."          # caller ID the customer sees
# Produced by: python setup_twilio.py --create-trunk
SIP_OUTBOUND_TRUNK_ID=""

# --- Bank identity and limits ---
BANK_NAME="Sahara Bank"
AGENT_DISPLAY_NAME="Tsaro"
FRAUD_DESK_NUMBER="+2348000000000"
MAX_CALL_SECONDS="300"
MAX_VERIFICATION_ATTEMPTS="3"
AGENT_NAME="fraud-response-agent"

# --------------------------------------------------------------------------
# Ports. docker-compose.yml reads these for both the published port and the
# health check, so changing one here is the only change needed.
# --------------------------------------------------------------------------
# The WhatsApp webhook and the simulated bank's REST surface. This is the one
# that has to be reachable from the internet, so it is the one to point a
# tunnel at.
APP_PORT="8000"
# Each LiveKit worker serves its own status endpoint, so the two agents cannot
# share a port. They only need to differ from each other.
AGENT_HTTP_PORT="8081"
TELCO_HTTP_PORT="8082"

# How many job runners each agent keeps warm. Every runner loads its own copy
# of the voice activity detector, so on a small machine the default of 8 will
# saturate the CPU before a call even arrives - the detector then blocks the
# event loop, the worker misses LiveKit's ping, and calls drop for what looks
# like a network fault. One is plenty for a single call at a time.
AGENT_IDLE_PROCESSES="1"
